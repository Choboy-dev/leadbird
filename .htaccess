# Security headers
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# Deny access to sensitive app internals (document root = app root).
<IfModule mod_authz_core.c>
    <FilesMatch "^(config\.php|\.env.*|composer\.(json|lock)|README\.md|error_log|php_errorlog|deploy\.json|\.user\.ini)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "(\.(log|sql|bak|old|swp|tar|gz|zip)|~)$|^\._">
        Require all denied
    </FilesMatch>
</IfModule>

# Fallback for older Apache
<IfModule !mod_authz_core.c>
    <FilesMatch "^(config\.php|\.env.*)$">
        Deny from all
    </FilesMatch>
</IfModule>

# Block sensitive directories by rewrite (works even when Directory blocks are limited on shared hosting)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteRule ^(scripts|jobs|lib|includes|database|logs|vendor|\.git|storage/rate-limits|storage/tmp)(/|$) - [F,L]

    RewriteRule ^config(/|$) - [F,L]

    # Legacy admin URL (blocked by hosts when path contains /config)
    RewriteRule ^admin/config/?$ admin/feature-flags [R=301,L]

    # Affiliate referral short links: /r/CODE
    RewriteRule ^r/([A-Za-z0-9_-]+)/?$ r.php?code=$1 [L,QSA]

    # Help center topic & article URLs
    RewriteRule ^help/([^/]+)/([^/]+)/?$ help.php?topic=$1&article=$2 [L,QSA]
    RewriteRule ^help/([^/]+)/?$ help.php?topic=$1 [L,QSA]

    # Static assets and uploads — serve as-is
    RewriteRule ^(assets|storage)/ - [L]

    # Static assets and uploads — serve as-is, never execute scripts
    RewriteRule ^(assets|storage)/.*\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|shtml)$ - [F,L,NC]
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ %1 [R=301,L,NE,QSA]

    # Single-segment URL: prefer businesses.php over businesses/ folder (avoids 403)
    RewriteCond %{REQUEST_URI} ^/([^/.]+)/?$
    RewriteCond %{DOCUMENT_ROOT}/%1.php -f
    RewriteRule ^[^/.]+/?$ %1.php [L,QSA]

    # Nested extensionless → .php handler (e.g. businesses/switch, billing/callback)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]

    # Existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Home
    RewriteRule ^$ index.php [L]
</IfModule>
