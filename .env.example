# App
APP_URL=https://leadbird.app
APP_ENV=production
APP_TIMEZONE=Africa/Lagos

# Hostinger MySQL (hPanel → Databases → MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_CHARSET=utf8mb4

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI: https://leadbird.app/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lead Bird <onboarding@leadbird.app>
BRAND_NAME=Lead Bird

# Private webmail — https://leadbird.app/mail/login
# Webhook URL in Resend: https://leadbird.app/webhooks/resend-mail  (event: email.received)
MAIL_DOMAIN=leadbird.app
MAIL_APP_NAME=Lead Bird Mail
MAIL_ADMIN_EMAIL=admin@leadbird.app
MAIL_ADMIN_DISPLAY_NAME=Lead Bird Admin
MAIL_PATH=/mail
MAIL_CATCH_ALL_EMAIL=admin@leadbird.app
MAIL_MAX_ATTACHMENT_BYTES=10485760
MAIL_MAX_ATTACHMENTS=10
# Paste the whsec_… signing secret from the Resend webhook here:
RESEND_WEBHOOK_SECRET=

# Contact page
CONTACT_PHONE=+234 800 000 0000
CONTACT_EMAIL=hello@leadbird.app
CONTACT_INBOX_EMAIL=hello@leadbird.app
CONTACT_WEB_LABEL=leadbird.app

# OTP email sign-in
OTP_LENGTH=6

# Admin portal — comma-separated emails with admin access (also set users.role = admin in DB)
ADMIN_EMAILS=you@leadbird.app

# Meta App Review tester login (https://leadbird.app/review/login) — disabled when APP_REVIEW_ENABLED=0
APP_REVIEW_ENABLED=0
APP_REVIEW_EMAIL=metareview@leadbird.app
APP_REVIEW_PASSWORD=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# How long to remember a pricing plan chosen before sign-up (minutes)
PLAN_SELECTION_TTL_MINUTES=30

# Dashboard session security (idle auto sign-out)
AUTH_IDLE_TIMEOUT_MINUTES=30
AUTH_IDLE_WARNING_SECONDS=120
AUTH_ABSOLUTE_TIMEOUT_HOURS=12

# Flutterwave (https://dashboard.flutterwave.com → Settings → API)
# Webhook URL: https://leadbird.app/auth/webhooks/flutterwave.php
# Cards are entered on Flutterwave's hosted checkout; renewals charge the saved card token.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# Legacy Flutterwave payment plan IDs (no longer attached at checkout; renewals are charged by scripts/renew-subscriptions.php)
# Monthly USD plans (international cards)
FLUTTERWAVE_PLAN_STARTER_USD=
FLUTTERWAVE_PLAN_VENDOR_USD=
FLUTTERWAVE_PLAN_SHOP_USD=
# Monthly NGN plans (Nigerian cards)
FLUTTERWAVE_PLAN_STARTER_NGN=
FLUTTERWAVE_PLAN_VENDOR_NGN=
FLUTTERWAVE_PLAN_SHOP_NGN=
# Annual USD plans (pay 10 months, 2 months free)
FLUTTERWAVE_PLAN_STARTER_ANNUAL_USD=
FLUTTERWAVE_PLAN_VENDOR_ANNUAL_USD=
FLUTTERWAVE_PLAN_SHOP_ANNUAL_USD=
# Annual NGN plans
FLUTTERWAVE_PLAN_STARTER_ANNUAL_NGN=
FLUTTERWAVE_PLAN_VENDOR_ANNUAL_NGN=
FLUTTERWAVE_PLAN_SHOP_ANNUAL_NGN=

# Fallback USD→NGN rate when Flutterwave rates API and cache are both unavailable (emergency only).
# Checkout and renewals always try Flutterwave live rates first.
FX_NGN_PER_USD=1364

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VISION_MODEL=gpt-4o-mini
# Max estimated OpenAI spend per business per calendar month (USD)
OPENAI_MONTHLY_BUDGET_USD=3
# Max spend for public site assistant + other non-business calls (USD)
OPENAI_PLATFORM_MONTHLY_BUDGET_USD=10

# Meta / WhatsApp Cloud API (developers.facebook.com)
# OAuth redirect: https://leadbird.app/auth/meta/callback
# Webhooks: https://leadbird.app/webhooks/meta and https://leadbird.app/webhooks/whatsapp
# Queue worker (cron every minute): scripts/process-automation-queue.php
# Scheduled social posts (cron every minute): scripts/process-scheduled-posts.php
# Stale social media cleanup (cron daily): scripts/cleanup-social-media.php
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
# Meta OAuth — see guides/meta-login-configuration.md
# 0 = scope-only OAuth (Hootsuite-style; no Meta page picker). 1 = config_id (shows Meta asset screen).
META_OAUTH_USE_LOGIN_CONFIG=0
# Must stay 0 for Hootsuite-style flow (1 = System-user page picker).
META_OAUTH_SYSTEM_USER_CONFIG=0
# Leave 0 unless Meta approves GDP for your app.
META_OAUTH_USE_GDP_FLOW=0
# 0 = platform-scoped OAuth (recommended). 1 = use bundled login config below for every connect.
META_USE_BUNDLED_LOGIN_CONFIG=0
# Legacy bundled Facebook Login for Business config (all platforms in one Meta flow)
META_FB_LOGIN_CONFIG_ID=
# Optional per-platform Login Config IDs (only used when META_OAUTH_USE_LOGIN_CONFIG=1)
META_FB_LOGIN_CONFIG_ID_WHATSAPP=
META_FB_LOGIN_CONFIG_ID_INSTAGRAM=
META_FB_LOGIN_CONFIG_ID_FACEBOOK=
META_ENABLE_PAGE_PUBLISH=0
META_ENABLE_IG_PUBLISH=0
WHATSAPP_SYSTEM_USER_TOKEN=
# META_SYSTEM_USER_TOKEN=

# TikTok — Login Kit redirect URI: https://leadbird.app/auth/tiktok/callback
TIKTOK_ENABLED=0
TIKTOK_SANDBOX=1
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.publish,video.upload,video.list
